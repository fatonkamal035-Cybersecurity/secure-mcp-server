from mcp.server import MCPServer
from core.security import ensure_non_root
from core.audit_extension import AuditExtension
from core.auth import JWTTokenVerifier
from mcp.server.auth.settings import AuthSettings
from config import MCP_HOST, MCP_PORT, MCP_ISSUER, MCP_RESOURCE
import logging

from tools import (
    kali_info,
    system_status,
    disk_status,
    memory_status,
    network_status,
    network_interfaces,
    read_text_file,
)

logging.basicConfig(
    filename="logs/audit.log",
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(name)s %(message)s",
)

mcp = MCPServer(
    "KaliServer",
    token_verifier=JWTTokenVerifier(),
    auth=AuthSettings(
        issuer_url=MCP_ISSUER,
        resource_server_url=MCP_RESOURCE,
        required_scopes=["mcp:read"],
        validate_token_resource=True,
    ),
    extensions=[AuditExtension()],
)
ensure_non_root()


mcp.tool()(kali_info)
mcp.tool()(system_status)
mcp.tool()(disk_status)
mcp.tool()(memory_status)
mcp.tool()(network_status)
mcp.tool()(network_interfaces)
mcp.tool()(read_text_file)


if __name__ == "__main__":
    mcp.run(
        transport="streamable-http",
        host=MCP_HOST,
        port=MCP_PORT,
    )
